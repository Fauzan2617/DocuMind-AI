# ============================================================
# DocuMind AI — Environment Variables
# Rename file ini jadi .env dan isi nilainya
# ============================================================

# --- LLM Provider ---
# Groq (free tier): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant       # gratis & cepet

# Ollama (local, 100% gratis) — aktifkan kalau mau on-prem
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- Embedding ---
# Jalan local, gratis sepenuhnya
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector DB ---
CHROMA_PERSIST_DIR=./data/vectorstore

# --- App Config ---
APP_NAME=DocuMind AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- API Settings ---
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_SIZE_MB=10

# --- Caching ---
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=100

# --- MLflow ---
MLFLOW_TRACKING_URI=./logs/mlflow
MLFLOW_EXPERIMENT_NAME=documind-experiments

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=20
